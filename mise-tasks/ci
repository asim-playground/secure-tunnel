#!/usr/bin/env bash
#MISE description="Canonical local/CI pipeline"
set -euo pipefail

mise run build-all
mise run sdk:check-bindings
if [[ "$(uname -s)" != MINGW* && "$(uname -s)" != CYGWIN* && "$(uname -s)" != MSYS* ]]; then
  mise run sdk:kotlin
fi
if [[ "$(uname -s)" == "Darwin" && "${SECURE_TUNNEL_SKIP_SWIFT_SDK_TESTS:-0}" != "1" ]]; then
  mise run sdk:swift
fi
mise run lint-all
mise run test-all
mise run smoke
mise run conformance
mise run rust:coverage-ci
mise run deps-check
