#!/usr/bin/env bash
#MISE description="Run end-to-end smoke through generated UniFFI Kotlin bindings"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"
source mise-tasks/sdk/smoke-common.sh

mise run sdk:generate-bindings
mkdir -p target/sdk-smoke/kotlin

fixture_json="$(mktemp "${TMPDIR:-/tmp}/secure-tunnel-kotlin-fixture.XXXXXX.json")"
fixture_properties="${PWD}/target/sdk-smoke/kotlin-fixture.properties"
trap 'stop_secure_tunnel_fixture; rm -f "${fixture_json}"' EXIT

start_secure_tunnel_fixture "${fixture_json}"
python3 - "${fixture_json}" "${fixture_properties}" <<'PY'
import base64
import json
import sys
from pathlib import Path

fixture = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
props = {
    "descriptor_json_b64": base64.b64encode(
        fixture["descriptor_json"].encode("utf-8"),
    ).decode("ascii"),
    "outer_root_certificates_der_b64": ",".join(
        fixture["outer_root_certificates_der_b64"],
    ),
    "pinned_service_static_public_keys_b64": ",".join(
        fixture["pinned_service_static_public_keys_b64"],
    ),
    "now_unix_seconds": str(fixture["now_unix_seconds"]),
    "smoke_ping_b64": fixture["smoke_ping_b64"],
    "smoke_pong_b64": fixture["smoke_pong_b64"],
}
Path(sys.argv[2]).write_text(
    "".join(f"{key}={value}\n" for key, value in props.items()),
    encoding="utf-8",
)
PY

lib_name="$(secure_tunnel_library_name)"
gradle -p bindings/smoke/kotlin --quiet run \
  -PsecureTunnelFfiLib="${PWD}/target/debug/${lib_name}" \
  -PsecureTunnelFixtureProperties="${fixture_properties}"
