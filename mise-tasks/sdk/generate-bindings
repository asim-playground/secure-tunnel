#!/usr/bin/env bash
#MISE description="Generate UniFFI Swift, Kotlin, and Python bindings"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:?}"

case "$(uname -s)" in
  Darwin)
    lib_name="libsecure_tunnel_sdk_ffi.dylib"
    ;;
  Linux)
    lib_name="libsecure_tunnel_sdk_ffi.so"
    ;;
  CYGWIN* | MINGW* | MSYS*)
    lib_name="secure_tunnel_sdk_ffi.dll"
    ;;
  *)
    echo "unsupported platform: $(uname -s)" >&2
    exit 1
    ;;
esac

out_dir="${SECURE_TUNNEL_UNIFFI_OUT_DIR:-target/generated-bindings/uniffi}"
project_root="$(pwd -P)"
abs_out_dir="$(
  python3 - "${project_root}" "${out_dir}" <<'PY'
from pathlib import Path
import sys

root = Path(sys.argv[1]).resolve()
out = Path(sys.argv[2]).expanduser()
if not out.is_absolute():
    out = root / out
print(out.resolve(strict=False))
PY
)"
case "${abs_out_dir}" in
  "${project_root}/target/"*)
    ;;
  *)
    echo "refusing to remove non-target UniFFI output directory: ${abs_out_dir}" >&2
    exit 1
    ;;
esac

ffi_lib="target/debug/${lib_name}"

cargo build -p secure-tunnel-sdk-ffi --lib
rm -rf "${abs_out_dir}"
out_dir="${abs_out_dir}"
mkdir -p "${out_dir}/swift" "${out_dir}/kotlin" "${out_dir}/python"

for language in swift kotlin python; do
  cargo run -p secure-tunnel-uniffi-bindgen -- generate "${ffi_lib}" \
    --crate secure_tunnel_sdk_ffi \
    --language "${language}" \
    --out-dir "${out_dir}/${language}" \
    --no-format
done

cp "${ffi_lib}" "${out_dir}/python/${lib_name}"
